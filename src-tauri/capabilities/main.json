{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The bundled main window may read bootstrap metadata and invoke the trusted typed lifecycle boundary.",
  "windows": ["main"],
  "permissions": [
    "allow-get-bootstrap-info",
    "allow-get-lifecycle-view",
    "allow-reset-lifecycle-state",
    "allow-update-market-draft",
    "allow-update-refresh-settings",
    "allow-apply-market-context",
    "allow-refresh-market",
    "allow-refresh-if-due",
    "allow-refresh-after-wake",
    "allow-set-offline",
    "allow-cancel-refresh"
  ]
}
